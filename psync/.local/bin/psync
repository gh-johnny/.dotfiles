#!/usr/bin/env bash
# psync — keep your folders identical on every host with Syncthing.
#
#   psync status        folders, peers, pending changes and conflicts (exit 1 if not in sync)
#   psync wait [SECS]   block until every peer has everything (default timeout 600s)
#   psync ready [SECS]  for launchers and logins: wait briefly until this host caught up, never fails
#   psync backup [run|status|setup|restic ARGS...]   restic snapshots of ~/projects (opt-in per host)
#   psync conflicts     list *.sync-conflict-* files
#   psync pause         stop syncing every folder on this host (survives reboots)
#   psync resume        continue where it stopped
#   psync tidy          park git-index conflict copies outside the synced tree
#   psync check         tidy, then notify about conflicts, errors or a long disconnection (timer)
#   psync doctor [--roundtrip]   health check of this host, for after any change; --roundtrip also sends a canary file through
#   psync hosts         every host in the mesh: state, how much it has, how this host reaches it
#   psync add-host --id ID --name NAME [--address ADDR] [--no-introducer]   pair another host (on any host already in)
#   psync remove-host NAME|ID [--yes]   stop syncing with a host (its files stay where they are)
#   psync folders       every synced folder: state, how many hosts share it, where it lives
#   psync folder add ID PATH | add --preset claude|codex   sync one more folder (opt-in: run it on every host that wants it)
#   psync folder remove ID [--yes]   stop syncing a folder on this host (its files stay where they are)
#   psync setup --peer-id ID --peer-name NAME [--peer-address ADDR] [--listen ADDR] [--no-introducer]
#
# Thin wrapper over the local Syncthing REST API. Every host runs the same setup. The base folder
# (projects) takes its ignore patterns from dotfiles/psync/.config/psync/stignore, which syncs too.
# psync owns its Syncthing instance, so every folder in it is a psync folder and each command
# acts on all of them.

set -euo pipefail

# The base folder, created by `psync setup`. More folders come from `psync folder add`.
FOLDER_ID=projects
FOLDER_PATH="$HOME/projects"
IGNORE_INCLUDE="dotfiles/psync/.config/psync/stignore"
FOLDER_ID_RE='^[a-z0-9][a-z0-9._-]*$'
ST_HOME="${STHOMEDIR:-$HOME/.local/state/syncthing}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/psync"
# Folders added with `folder add` keep their old versions here, not inside the folder: a chat
# harness lists and resumes sessions by scanning its folder, and must not meet archived copies.
VERSIONS_DIR="$STATE_DIR/versions"
VERSIONS_MAX_AGE=$((30 * 86400))
DISCONNECT_WARN_AFTER=3600
# Backups live outside ~/projects (or they would be synced back), password included.
BACKUP_REPO="${XDG_DATA_HOME:-$HOME/.local/share}/psync-backup/repo"
BACKUP_PASSWORD="$STATE_DIR/backup-password"
BACKUP_EXCLUDES="$HOME/.config/psync/backup-excludes"
BACKUP_MIN_FREE_GB=30
BACKUP_KEEP=(--keep-daily 7 --keep-weekly 4 --keep-monthly 6)
BACKUP_STALE_AFTER=$((36 * 3600))
DISK_WARN_GB=${PSYNC_DISK_WARN_GB:-20}
ROUNDTRIP_TIMEOUT=${PSYNC_ROUNDTRIP_TIMEOUT:-90}
KEY_WARN_DAYS=120
KEY_FAIL_DAYS=30
DEVICE_ID_RE='^([A-Z0-9]{7}-){7}[A-Z0-9]{7}$'

die() { echo "psync: $*" >&2; exit 1; }

config_value() {
  local cfg="$ST_HOME/config.xml"
  [[ -r $cfg ]] || die "no Syncthing config at $cfg (run: psync setup)"
  case $1 in
    apikey) sed -n 's:.*<apikey>\(.*\)</apikey>.*:\1:p' "$cfg" | head -1 ;;
    address) sed -n '/<gui /,/<\/gui>/s:.*<address>\(.*\)</address>.*:\1:p' "$cfg" | head -1 ;;
  esac
}

# api METHOD PATH [JSON]
api() {
  local method=$1 path=$2 body=${3-}
  local args=(-fsS --max-time 120 -X "$method" -H "X-API-Key: $(config_value apikey)")
  [[ -n $body ]] && args+=(-H 'Content-Type: application/json' --data "$body")
  curl "${args[@]}" "http://$(config_value address)/rest/$path"
}

my_id() { api GET system/status | jq -r .myID; }

# --- Folders. Every command acts on all of them; the order is the one Syncthing lists them in.

folder_ids() { api GET config/folders | jq -r '.[].id'; }

# folder_path ID → absolute path
folder_path() {
  local p
  p=$(api GET "config/folders/$1" | jq -r .path)
  echo "${p/#\~/$HOME}"
}

folder_paths() {
  local id
  for id in $(folder_ids); do folder_path "$id"; done
}

# active_folders: the folders that are not paused on this host
active_folders() {
  local id
  for id in $(folder_ids); do
    [[ $(api GET "config/folders/$id" | jq -r .paused) == false ]] && echo "$id"
  done
  return 0
}

# all_idle ID...: succeeds when none of these folders has anything to pull
all_idle() {
  local id
  for id in "$@"; do
    [[ $(api GET "db/status?folder=$id" | jq -r '.state + (.needTotalItems | tostring)') == idle0 ]] || return 1
  done
}

# folder_peers ID: the other hosts this folder is shared with
folder_peers() {
  api GET "config/folders/$1" | jq -r --arg me "$(my_id)" '.devices[].deviceID | select(. != $me)'
}

# peers: every other host that shares at least one folder with this one
peers() {
  api GET config/folders | jq -r --arg me "$(my_id)" '[.[].devices[].deviceID | select(. != $me)] | unique[]'
}

# not_sharing COMPLETION_JSON: a connected host that has not added the folder yet. Sharing is opt-in
# on each host, so this is nothing to wait for (and not an error), only worth mentioning. Syncthing
# 2.1 reports such a host as "unknown" (it only has an offer for the folder), never "notSharing".
not_sharing() {
  case $(jq -r '.remoteState // "valid"' <<<"$1") in
    unknown | notSharing) return 0 ;;
    *) return 1 ;;
  esac
}

# last_seen DEVICE_ID [STATS_JSON]   (stats/device is fetched when not given)
last_seen() {
  jq -r --arg id "$1" '.[$id].lastSeen // "" |
    if . == "" or startswith("1969") or startswith("1970") then "never" else .[0:19] end' \
    <<<"${2:-$(api GET stats/device)}"
}

conflict_files() {
  local p
  while IFS= read -r p; do
    find "$p" \( -name node_modules -o -name .venv -o -name .stversions \) -prune \
      -o -name '*.sync-conflict-*' -print 2>/dev/null || true
  done < <(folder_paths)
}

# `git status` rewrites .git/index, so two hosts touching the same repo at the same
# moment make Syncthing keep a losing copy. The index is a cache (staged content
# survives as objects), so park those copies outside the synced tree for a week
# instead of raising an alarm.
park_index_conflicts() {
  local f p dest="$STATE_DIR/index-conflicts"
  mkdir -p "$dest"
  while IFS= read -r p; do
    while IFS= read -r -d '' f; do
      mv -- "$f" "$dest/$(date +%s)-${f//\//_}" && echo "parked git index conflict: ${f/#"$HOME"/\~}"
    done < <(find "$p" \( -name node_modules -o -name .venv -o -name .stversions \) -prune \
      -o -path '*/.git/*' -name 'index.sync-conflict-*' -mmin +2 -print0 2>/dev/null)
  done < <(folder_paths)
  find "$dest" -type f -mtime +7 -delete 2>/dev/null || true
}

# Edits made while Syncthing's startup scan runs are never reported by the filesystem
# watcher and would wait for the next scheduled full rescan (a day). So once per
# Syncthing start, as soon as the startup scan is over, request one more full scan.
settle_scan() {
  local started id
  started=$(api GET system/status | jq -r .startTime)
  for id in $(folder_ids); do
    [[ $(cat "$STATE_DIR/settled-$id" 2>/dev/null) != "$started" ]] || continue
    [[ $(api GET "db/status?folder=$id" | jq -r .state) == idle ]] || continue
    echo "$started" >"$STATE_DIR/settled-$id"
    # The call returns only when the scan ends; the request itself is queued at once.
    api POST "db/scan?folder=$id" >/dev/null 2>&1 &
  done
  sleep 1
}

# report_folder ID CONNS LABEL: the lines for one folder (LABEL tells them apart when there are
# several); returns 0 only when nothing is pending. Disconnected hosts are left to `report`.
report_folder() {
  local fid=$1 conns=$2 lab=$3 db comp errors rc=0 id name completion
  if [[ $(api GET "config/folders/$fid" | jq -r .paused) == true ]]; then
    echo "folder:    ${lab}PAUSED on this host (psync resume)"
    return 1
  fi
  db=$(api GET "db/status?folder=$fid")
  jq -r --arg lab "$lab" '"folder:    \($lab)\(.state), \(.needTotalItems) item(s) / \(.needBytes) bytes to pull"' <<<"$db"
  [[ $(jq -r '.state + (.needTotalItems | tostring)' <<<"$db") == idle0 ]] || rc=1

  for id in $(folder_peers "$fid"); do
    [[ $(jq -r --arg id "$id" '.connections[$id].connected // false' <<<"$conns") == true ]] || continue
    name=$(api GET "config/devices/$id" | jq -r .name)
    comp=$(api GET "db/completion?folder=$fid&device=$id")
    if not_sharing "$comp"; then
      echo "peer:      ${lab}$name connected, but has not added this folder (there: psync folder add)"
      continue
    fi
    completion=$(jq -r '.completion | floor' <<<"$comp")
    echo "peer:      ${lab}$name connected, has ${completion}% of this host's data"
    [[ $completion == 100 ]] || rc=1
  done

  errors=$(api GET "folder/errors?folder=$fid" | jq '.errors // [] | length')
  if ((errors > 0)); then
    echo "errors:    ${lab}$errors (details: journalctl --user -u syncthing, or the GUI at $(config_value address))"
    rc=1
  fi
  return $rc
}

# Prints folder, peer and error lines; returns 0 only when nothing is pending anywhere.
report() {
  local ids=() id conns stats lab rc=0
  mapfile -t ids < <(folder_ids)
  ((${#ids[@]} > 0)) || { echo "folder:    none set up (psync setup)"; return 1; }
  conns=$(api GET system/connections)
  stats=$(api GET stats/device)
  for id in "${ids[@]}"; do
    lab=""
    if ((${#ids[@]} > 1)); then lab="[$id] "; fi
    report_folder "$id" "$conns" "$lab" || rc=1
  done
  for id in $(peers); do
    [[ $(jq -r --arg id "$id" '.connections[$id].connected // false' <<<"$conns") == true ]] && continue
    echo "peer:      $(api GET "config/devices/$id" | jq -r .name) DISCONNECTED (last seen $(last_seen "$id" "$stats"))"
    rc=1
  done
  return $rc
}

cmd_status() {
  local rc=0 conflicts
  report || rc=1
  conflicts=$(conflict_files | wc -l)
  ((conflicts == 0)) || { echo "conflicts: $conflicts (psync conflicts)"; rc=1; }
  ((rc == 0)) && echo "in sync" || echo "NOT in sync"
  return $rc
}

cmd_wait() {
  local timeout=${1:-600} stable=0 start=$SECONDS
  # No forced rescan: the filesystem watcher already reports edits (a full rescan of
  # ~500k files takes ~6 min and would block the folder). Four clean checks 5s apart
  # span the 10s watcher delay, so an edit made just before this call is not missed.
  while ((SECONDS - start < timeout)); do
    if report >/dev/null; then
      ((++stable < 4)) || { cmd_status; return; }
    else
      stable=0
    fi
    sleep 5
  done
  cmd_status || true
  die "still not in sync after ${timeout}s"
}

# Run before work starts on this host (the `ai` launcher, an SSH login). Instant and silent
# when there is nothing to pull; otherwise waits (default 60s) for what the other host
# already announced, so a half-arrived commit is not met by git. Says so when a peer is
# offline, because whatever it has not sent yet cannot be here. Never fails, never blocks
# longer than SECS: Ctrl-C skips the wait. Edits made on the other host in the last ~10s
# are not announced yet; that side's `psync wait` covers them.
cmd_ready() {
  local timeout=${1:-60} start=$SECONDS waited=0 settled=0 caught_up=0 conns id active=()
  trap 'echo "psync: wait skipped" >&2; exit 0' INT
  api GET system/ping >/dev/null 2>&1 || { echo "psync: Syncthing is not running here (psync resume)" >&2; return 0; }
  mapfile -t active < <(active_folders)
  ((${#active[@]} > 0)) \
    || { echo "psync: sync is paused on this host (psync resume), or no folder is set up (psync setup)" >&2; return 0; }

  while true; do
    if all_idle "${active[@]}"; then
      # After a wait, look once more: the next batch may be announced only now.
      if ((waited == 0 || settled++ > 0)); then
        caught_up=1
        break
      fi
    else
      settled=0
      ((waited++ > 0)) || echo "psync: catching up with the other host (Ctrl-C skips)..." >&2
    fi
    if ((SECONDS - start >= timeout)); then
      echo "psync: still syncing after ${timeout}s, continuing anyway (follow with: psync wait)" >&2
      break
    fi
    sleep 2
  done
  ((waited > 0 && caught_up)) && echo "psync: caught up" >&2

  conns=$(api GET system/connections)
  for id in $(peers); do
    [[ $(jq -r --arg id "$id" '.connections[$id].connected // false' <<<"$conns") == true ]] && continue
    echo "psync: $(api GET "config/devices/$id" | jq -r .name) is offline (last seen $(last_seen "$id")), so what it has not sent yet is not here" >&2
  done
  backup_warning >&2
  return 0
}

# --- Backups. Sync is not a backup: a deletion or a bad overwrite travels to the other host.
# restic keeps point-in-time history of ~/projects (deduplicated and compressed). Opt-in per
# host: `psync backup setup` creates the repository and enables the daily timer; the VPS runs it.

restic_repo() {
  RESTIC_REPOSITORY=$BACKUP_REPO RESTIC_PASSWORD_FILE=$BACKUP_PASSWORD restic "$@"
}

backup_have_repo() { [[ -e $BACKUP_REPO/config ]]; }

# One line when this host makes backups and the last one failed or is overdue.
backup_warning() {
  local state=$STATE_DIR/backup-last status when
  [[ -r $state ]] || return 0
  read -r status when <"$state"
  if [[ $status != ok ]]; then
    echo "psync: the last backup FAILED ($(cut -d' ' -f3- "$state")), see: psync backup status"
  elif (($(date +%s) - when > BACKUP_STALE_AFTER)); then
    echo "psync: no successful backup for over $((BACKUP_STALE_AFTER / 3600))h, see: psync backup status"
  fi
}

backup_setup() {
  command -v restic >/dev/null || die "restic is not installed"
  mkdir -p "$STATE_DIR" "$BACKUP_REPO"
  if [[ ! -s $BACKUP_PASSWORD ]]; then
    (umask 077 && openssl rand -base64 33 >"$BACKUP_PASSWORD")
    echo "created $BACKUP_PASSWORD: keep a copy somewhere safe, without it the snapshots cannot be opened"
  fi
  backup_have_repo || restic_repo init
  systemctl --user enable --now psync-backup.timer
}

backup_run() {
  local free_gb rc=0
  backup_have_repo || die "no backup repository on this host (run: psync backup setup)"
  mkdir -p "$STATE_DIR"
  free_gb=$(($(df --output=avail -k "$BACKUP_REPO" | tail -1) / 1048576))
  if ((free_gb < BACKUP_MIN_FREE_GB)); then
    echo "fail $(date +%s) only ${free_gb}GB free, needs ${BACKUP_MIN_FREE_GB}GB" >"$STATE_DIR/backup-last"
    die "only ${free_gb}GB free (< ${BACKUP_MIN_FREE_GB}GB): not taking a snapshot"
  fi
  restic_repo backup "$FOLDER_PATH" --exclude-file "$BACKUP_EXCLUDES" --one-file-system --tag psync || rc=$?
  # Exit 3: some files changed or vanished while being read. The snapshot exists.
  ((rc != 3)) || rc=0
  ((rc != 0)) || restic_repo forget "${BACKUP_KEEP[@]}" --prune --tag psync || rc=$?
  if ((rc == 0)); then
    echo "ok $(date +%s)" >"$STATE_DIR/backup-last"
  else
    echo "fail $(date +%s) restic exited with $rc" >"$STATE_DIR/backup-last"
  fi
  return $rc
}

backup_status() {
  backup_have_repo || die "no backup repository on this host (run: psync backup setup)"
  restic_repo snapshots --compact
  echo "repository: $(du -sh "$BACKUP_REPO" | cut -f1) used, $(df -h --output=avail "$BACKUP_REPO" | tail -1 | tr -d ' ') free on the disk"
  if [[ -r $STATE_DIR/backup-last ]]; then
    echo "last run:   $(cut -d' ' -f1 "$STATE_DIR/backup-last") at $(date -d "@$(cut -d' ' -f2 "$STATE_DIR/backup-last")" '+%F %T')"
  fi
  backup_warning || true
}

cmd_backup() {
  case ${1:-run} in
    run) backup_run ;;
    status) backup_status ;;
    setup) backup_setup ;;
    restic) shift; backup_have_repo || die "no backup repository on this host"; restic_repo "$@" ;;
    *) die "usage: psync backup [run|status|setup|restic ARGS...]" ;;
  esac
}

cmd_check() {
  local conflicts errors conns now id msgs=() active=()
  # Stopped or paused on purpose (psync pause): nothing to warn about.
  api GET system/ping >/dev/null 2>&1 || return 0
  mapfile -t active < <(active_folders)
  ((${#active[@]} > 0)) || return 0
  mkdir -p "$STATE_DIR"
  now=$(date +%s)

  settle_scan
  park_index_conflicts
  conflicts=$(conflict_files | wc -l)
  if ((conflicts > 0)) && [[ $conflicts != "$(cat "$STATE_DIR/conflicts" 2>/dev/null)" ]]; then
    msgs+=("$conflicts sync conflict(s) — run: psync conflicts")
  fi
  echo "$conflicts" >"$STATE_DIR/conflicts"

  for id in "${active[@]}"; do
    errors=$(api GET "folder/errors?folder=$id" | jq '.errors // [] | length')
    ((errors == 0)) || msgs+=("$errors error(s) in folder $id — run: psync status")
  done

  conns=$(api GET system/connections)
  for id in $(peers); do
    if [[ $(jq -r --arg id "$id" '.connections[$id].connected // false' <<<"$conns") == true ]]; then
      rm -f "$STATE_DIR/down-$id" "$STATE_DIR/warned-$id"
      continue
    fi
    [[ -e $STATE_DIR/down-$id ]] || echo "$now" >"$STATE_DIR/down-$id"
    if ((now - $(cat "$STATE_DIR/down-$id") > DISCONNECT_WARN_AFTER)) && [[ ! -e $STATE_DIR/warned-$id ]]; then
      msgs+=("$(api GET "config/devices/$id" | jq -r .name) has been disconnected for over an hour")
      touch "$STATE_DIR/warned-$id"
    fi
  done

  for msg in "${msgs[@]}"; do
    echo "$msg" >&2
    if command -v notify-send >/dev/null; then notify-send -u critical psync "$msg" || true; fi
  done
}

# --- doctor: one pass over everything psync depends on, for after any change (a config or ignore
# edit, an upgrade, a reinstall, a new host). ok = fine, warn = worth a look, FAIL = broken;
# only FAIL makes the exit code 1. The warnings are conditions that come and go (a peer asleep,
# edits still travelling), FAILs are things that stay broken until someone fixes them.

doctor_fails=0
doctor_warns=0
d_ok() { printf '  ok    %s\n' "$*"; }
d_warn() { printf '  warn  %s\n' "$*"; doctor_warns=$((doctor_warns + 1)); }
d_fail() { printf '  FAIL  %s\n' "$*"; doctor_fails=$((doctor_fails + 1)); }

# doctor_roundtrip ID PATH LABEL: writes a canary in the folder and waits until every connected peer
# reports having it: the one check that covers scan, announce, transfer and the ignore rules together.
# A peer that has not added the folder cannot get it and is skipped.
doctor_roundtrip() {
  local fid=$1 fpath=$2 lab=$3
  local canary=$fpath/.psync-canary-$(uname -n)-$$ start=$SECONDS id pending=() connected=0 conns comp
  conns=$(api GET system/connections)
  for id in $(folder_peers "$fid"); do
    [[ $(jq -r --arg id "$id" '.connections[$id].connected // false' <<<"$conns") == true ]] || continue
    connected=1
    comp=$(api GET "db/completion?folder=$fid&device=$id")
    ! not_sharing "$comp" || continue
    pending+=("$id")
  done
  ((connected)) || { d_fail "roundtrip$lab: no peer is connected, nothing to send the canary to"; return; }
  ((${#pending[@]} > 0)) || { d_warn "roundtrip$lab: no connected peer has added this folder yet (there: psync folder add)"; return; }

  date +%s >"$canary"
  while ((${#pending[@]} > 0 && SECONDS - start < ROUNDTRIP_TIMEOUT)); do
    sleep 2
    local still=()
    for id in "${pending[@]}"; do
      api GET "db/file?folder=$fid&file=${canary##*/}" 2>/dev/null |
        jq -e --arg id "$id" '.availability // [] | any(.id == $id)' >/dev/null 2>&1 || still+=("$id")
    done
    pending=("${still[@]}")
  done
  rm -f -- "$canary"
  if ((${#pending[@]} == 0)); then
    d_ok "roundtrip$lab: a canary file reached every connected peer in $((SECONDS - start))s"
  else
    d_fail "roundtrip$lab: the canary did not reach $(api GET "config/devices/${pending[0]}" | jq -r .name) within ${ROUNDTRIP_TIMEOUT}s"
  fi
}

cmd_doctor() {
  local roundtrip=false out="" unit n free_gb ts state expiry days w id p avail mount lab down=() ids=() paused=0
  local -A seen_mount=()
  [[ ${1-} != --roundtrip ]] || roundtrip=true
  doctor_fails=0 doctor_warns=0
  echo "psync doctor ($(uname -n))"

  if ! api GET system/ping >/dev/null 2>&1; then
    d_fail "Syncthing is not running (psync resume)"
    echo "result: $doctor_fails problem(s)"
    return 1
  fi
  d_ok "Syncthing $(api GET system/version | jq -r .version) is running"

  mapfile -t ids < <(folder_ids)
  if ((${#ids[@]} == 0)); then
    d_fail "no folder is set up (psync setup)"
  else
    for id in "${ids[@]}"; do
      if [[ $(api GET "config/folders/$id" | jq -r .paused) == true ]]; then
        d_fail "folder $id is paused on this host (psync resume)"
        paused=1
      fi
    done
    if ((paused == 0)); then
      if out=$(report); then
        d_ok "in sync with every peer"
      else
        d_warn "not fully in sync (normal right after an edit or while a peer is offline):"
        sed 's/^/            /' <<<"$out"
      fi
    fi
    if [[ $out == *"has not added this folder"* ]]; then
      d_warn "a peer has not added a folder this host shares (run psync folder add there):"
      grep 'has not added this folder' <<<"$out" | sed 's/^/            /'
    fi
  fi

  n=$(conflict_files | wc -l)
  if ((n == 0)); then d_ok "no sync conflicts"; else d_warn "$n sync conflict(s) (psync conflicts)"; fi

  if [[ $(cat "$FOLDER_PATH/.stignore" 2>/dev/null) == "#include $IGNORE_INCLUDE" && -r $FOLDER_PATH/$IGNORE_INCLUDE ]]; then
    d_ok "ignore rules: ~/projects/.stignore includes $IGNORE_INCLUDE"
  else
    d_fail "ignore rules: ~/projects/.stignore does not include $IGNORE_INCLUDE (psync setup)"
  fi

  local units=(syncthing.service psync-check.timer)
  ! backup_have_repo || units+=(psync-backup.timer)
  for unit in "${units[@]}"; do
    systemctl --user is-active --quiet "$unit" && systemctl --user is-enabled --quiet "$unit" || down+=("$unit")
  done
  if ((${#down[@]} == 0)); then d_ok "enabled and active: ${units[*]}"; else d_fail "not enabled or not active: ${down[*]}"; fi

  if backup_have_repo; then
    w=$(backup_warning)
    if [[ -n $w ]]; then
      d_fail "${w#psync: }"
    elif [[ -r $STATE_DIR/backup-last ]]; then
      d_ok "backup: last run ok at $(date -d "@$(cut -d' ' -f2 "$STATE_DIR/backup-last")" '+%F %T')"
    else
      d_warn "backup: repository exists but no run recorded yet (psync backup)"
    fi
  fi

  # One line per filesystem, named after the first folder on it
  for id in "${ids[@]}"; do
    p=$(folder_path "$id")
    if [[ ! -d $p ]]; then
      d_fail "folder $id: ${p/#"$HOME"/\~} does not exist"
      continue
    fi
    read -r avail mount < <(df --output=avail,target -k "$p" | tail -1)
    [[ -z ${seen_mount[$mount]-} ]] || continue
    seen_mount[$mount]=1
    free_gb=$((avail / 1048576))
    if ((free_gb < DISK_WARN_GB)); then
      d_warn "disk: only ${free_gb}GB free where ${p/#"$HOME"/\~} lives"
    else
      d_ok "disk: ${free_gb}GB free where ${p/#"$HOME"/\~} lives"
    fi
  done

  if command -v tailscale >/dev/null; then
    ts=$(timeout 10 tailscale status --json 2>/dev/null || true)
    state=$(jq -r '.BackendState // "unknown"' <<<"${ts:-null}")
    expiry=$(jq -r '.Self.KeyExpiry // ""' <<<"${ts:-null}")
    if [[ $state != Running ]]; then
      d_fail "tailscale is $state, the other host cannot be reached"
    elif [[ -z $expiry ]]; then
      d_ok "tailscale running, this node's key does not expire"
    else
      days=$((($(date -d "$expiry" +%s) - $(date +%s)) / 86400))
      if ((days <= KEY_FAIL_DAYS)); then
        d_fail "tailscale node key expires in ${days} days (${expiry%%T*}): disable key expiry in the admin console"
      elif ((days <= KEY_WARN_DAYS)); then
        d_warn "tailscale node key expires in ${days} days (${expiry%%T*}): disable key expiry in the admin console"
      else
        d_ok "tailscale running, node key valid until ${expiry%%T*}"
      fi
    fi
  fi

  if grep -qs 'psync ready' "$HOME/.zshrc"; then
    d_ok "switching hosts waits for pending changes (psync ready in ~/.zshrc)"
  else
    d_warn "no 'psync ready' in ~/.zshrc: the next host switch will not wait for pending changes"
  fi
  if [[ -f $HOME/.local/bin/ai && ! -L $HOME/.local/bin/ai ]] && ! grep -qs 'psync' "$HOME/.local/bin/ai"; then
    d_warn "~/.local/bin/ai does not call psync ready"
  fi

  if [[ -e /etc/systemd/system/psync-ssh-guard.timer ]]; then
    if systemctl is-active --quiet psync-ssh-guard.timer; then
      d_ok "public SSH guard timer is active"
    else
      d_fail "psync-ssh-guard.timer is not active: a Tailscale outage would lock you out"
    fi
  fi

  if $roundtrip; then
    for id in "${ids[@]}"; do
      lab=""
      if ((${#ids[@]} > 1)); then lab=" ($id)"; fi
      doctor_roundtrip "$id" "$(folder_path "$id")" "$lab"
    done
  fi
  if ((doctor_fails > 0)); then
    echo "result: $doctor_fails problem(s)"
    return 1
  elif ((doctor_warns > 0)); then
    echo "result: no failures, $doctor_warns warning(s)"
  else
    echo "result: all good"
  fi
}

# --- The mesh. Every host is a full peer: any one of them can be lost or replaced and the others
# keep a complete copy. Peers are marked as introducers by default (they are all yours): add a new
# host to ONE existing host and the others learn its ID and share the folder with it by themselves.
# Syncthing does not pass addresses along, and psync switches discovery off, so two hosts that only
# know each other through an introducer reach each other via that host until one of them is given
# the other's address (add-host --address). `psync hosts` shows which is which.

# put_device ID NAME ADDRESS INTRODUCER(true|false)   (replaces the whole device entry)
put_device() {
  api PUT "config/devices/$1" "$(jq -n --arg id "$1" --arg name "$2" --arg addr "$3" --argjson intro "$4" \
    '{deviceID: $id, name: $name, addresses: [$addr], compression: "metadata", autoAcceptFolders: false, introducer: $intro}')" >/dev/null
}

# share_folders DEVICE_ID: add the device to every folder it is not in yet (a folder config change
# restarts the folder and rescans it, so do not touch one for nothing). A host that has not added
# a folder itself only gets an offer for it, which it can ignore.
share_folders() {
  local fid folder
  for fid in $(folder_ids); do
    folder=$(api GET "config/folders/$fid")
    jq -e --arg id "$1" '.devices | any(.deviceID == $id)' <<<"$folder" >/dev/null && continue
    api PUT "config/folders/$fid" "$(jq --arg id "$1" '.devices += [{deviceID: $id}]' <<<"$folder")" >/dev/null
  done
}

# host_completion DEVICE_ID → the lowest completion over the folders shared with it that it has
# added ("100%"), or "-" when none counts
host_completion() {
  local fid c comp best=""
  for fid in $(folder_ids); do
    [[ $(folder_peers "$fid") == *"$1"* ]] || continue
    comp=$(api GET "db/completion?folder=$fid&device=$1")
    ! not_sharing "$comp" || continue
    c=$(jq -r '.completion | floor' <<<"$comp")
    if [[ -z $best ]] || ((c < best)); then best=$c; fi
  done
  echo "${best:+$best%}"
}

# resolve_host NAME|ID → device ID of a configured peer
resolve_host() {
  local found
  found=$(api GET config/devices | jq -r --arg t "$1" --arg me "$(my_id)" \
    '.[] | select(.deviceID != $me and (.name == $t or .deviceID == $t)) | .deviceID')
  [[ -n $found ]] || die "no host named or identified '$1' (see: psync hosts)"
  [[ $(wc -l <<<"$found") == 1 ]] || die "'$1' matches more than one host, use its device ID"
  echo "$found"
}

cmd_add_host() {
  local id="" name="" addr=dynamic intro=true
  while (($#)); do
    case $1 in
      --id) id=${2-}; shift 2 ;;
      --name) name=${2-}; shift 2 ;;
      --address) addr=${2-}; shift 2 ;;
      --no-introducer) intro=false; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ $id =~ $DEVICE_ID_RE ]] || die "--id must be the other host's Syncthing device ID (8 groups of 7, from 'psync setup' or 'psync hosts' there)"
  [[ -n $name ]] || die "--name is required"
  [[ $id != "$(my_id)" ]] || die "that is this host's own device ID"
  put_device "$id" "$name" "$addr" "$intro"
  share_folders "$id"
  echo "added host $name (${id:0:7}), reached via ${addr}$([[ $addr == dynamic ]] && echo ": it connects to this host, or through an introducer")"
  echo "follow with: psync hosts"
}

cmd_remove_host() {
  local target=${1-} id name answer fid folder
  [[ -n $target ]] || die "usage: psync remove-host NAME|ID [--yes]"
  shift
  id=$(resolve_host "$target")
  name=$(api GET "config/devices/$id" | jq -r .name)
  if [[ ${1-} != --yes ]]; then
    [[ -t 0 ]] || die "not a terminal: pass --yes to confirm removing $name"
    read -r -p "Stop syncing with $name? Its copy of the files stays where it is. [y/N] " answer
    [[ $answer == [yY]* ]] || { echo "aborted"; return 1; }
  fi
  for fid in $(folder_ids); do
    folder=$(api GET "config/folders/$fid")
    jq -e --arg id "$id" '.devices | any(.deviceID == $id)' <<<"$folder" >/dev/null || continue
    api PUT "config/folders/$fid" "$(jq --arg id "$id" '.devices |= map(select(.deviceID != $id))' <<<"$folder")" >/dev/null
  done
  api DELETE "config/devices/$id" >/dev/null
  echo "removed host $name (${id:0:7}); hosts that take this one as their introducer drop it too"
}

cmd_hosts() {
  local me devs conns stats id name state seen synced via addr reach fmt width indirect=0
  me=$(my_id)
  devs=$(api GET config/devices)
  conns=$(api GET system/connections)
  stats=$(api GET stats/device)
  width=$(jq -r '[.[].name | length + 7] + [16] | max' <<<"$devs")
  fmt="%-${width}s %-8s %-10s %-7s %-20s %s\n"
  # shellcheck disable=SC2059
  printf "$fmt" HOST ID STATE SYNCED "LAST SEEN" "REACHED VIA"
  for id in $(jq -r '.[].deviceID' <<<"$devs"); do
    name=$(jq -r --arg id "$id" '.[] | select(.deviceID == $id) | .name' <<<"$devs")
    if [[ $id == "$me" ]]; then
      # shellcheck disable=SC2059
      printf "$fmt" "$name (this)" "${id:0:7}" - - - -
      continue
    fi
    via=$(jq -r --arg id "$id" '.[] | select(.deviceID == $id) | .introducedBy // ""' <<<"$devs")
    addr=$(jq -r --arg id "$id" '.[] | select(.deviceID == $id) | .addresses | join(",")' <<<"$devs")
    if [[ $(jq -r --arg id "$id" '.connections[$id].connected // false' <<<"$conns") == true ]]; then
      state=connected
      seen=now
      synced=$(host_completion "$id")
      synced=${synced:--}
    else
      state=offline
      seen=$(last_seen "$id" "$stats")
      synced=-
    fi
    if [[ $addr == dynamic ]]; then
      if [[ -n $via ]]; then
        reach="through $(jq -r --arg v "$via" '.[] | select(.deviceID == $v) | .name' <<<"$devs") (introduced)"
        indirect=$((indirect + 1))
      else
        reach="it dials this host"
      fi
    else
      reach=$addr
    fi
    # shellcheck disable=SC2059
    printf "$fmt" "$name" "${id:0:7}" "$state" "$synced" "$seen" "$reach"
  done
  ((indirect == 0)) ||
    echo "note: hosts reached only through an introducer stop syncing with this one when that host is off; give them a direct address with: psync add-host --id ID --name NAME --address tcp://HOST:22000"
}

# --- Folders beyond the base one. Sharing is opt-in on each host: `folder add` there, and a folder
# is shared with every host this one knows (add-host shares every folder with a new host), so
# the order in which hosts add it does not matter.

# folder_json ID PATH DEVICES_JSON VERSIONING_JSON: a folder the way psync wants it on every host
folder_json() {
  api GET config/defaults/folder | jq --arg id "$1" --arg path "$2" --argjson devices "$3" --argjson versioning "$4" '. + {
    id: $id, label: $id, path: $path, type: "sendreceive", devices: $devices,
    order: "oldestFirst", fsWatcherEnabled: true, rescanIntervalS: 86400, maxConflicts: 10,
    versioning: (.versioning + $versioning)
  }'
}

cmd_folders() {
  local id state fmt="%-12s %-14s %-6s %s\n" p
  # shellcheck disable=SC2059
  printf "$fmt" FOLDER STATE HOSTS PATH
  for id in $(folder_ids); do
    if [[ $(api GET "config/folders/$id" | jq -r .paused) == true ]]; then
      state=paused
    else
      state=$(api GET "db/status?folder=$id" | jq -r .state)
    fi
    p=$(folder_path "$id")
    # shellcheck disable=SC2059
    printf "$fmt" "$id" "$state" "$(folder_peers "$id" | wc -l)" "${p/#"$HOME"/\~}"
  done
}

# folder_add ID PATH | --preset claude|codex
#   claude  the sessions and memory of Claude Code:  $CLAUDE_CONFIG_DIR or ~/.claude, then projects/
#   codex   the sessions of Codex:                   $CODEX_HOME or ~/.codex, then sessions/
# Only those directories, never the config dir around them, so logins and app databases cannot travel.
folder_add() {
  local fid="" fpath="" preset="" other opath devices
  while (($#)); do
    case $1 in
      --preset) preset=${2-}; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *) if [[ -z $fid ]]; then fid=$1; elif [[ -z $fpath ]]; then fpath=$1; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  if [[ -n $preset ]]; then
    [[ -z $fid ]] || die "give either --preset or ID PATH, not both"
    case $preset in
      claude) fid=claude; fpath=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects ;;
      codex) fid=codex; fpath=${CODEX_HOME:-$HOME/.codex}/sessions ;;
      *) die "unknown preset '$preset' (claude, codex)" ;;
    esac
  fi
  [[ -n $fid && -n $fpath ]] || die "usage: psync folder add ID PATH | add --preset claude|codex"
  [[ $fid =~ $FOLDER_ID_RE ]] || die "folder ID must be lowercase letters, digits, '.', '_' or '-' (got '$fid')"
  fpath=${fpath/#\~/$HOME}
  fpath=${fpath%/}
  [[ $fpath == /* ]] || die "PATH must be absolute (got '$fpath')"
  ! api GET "config/folders/$fid" >/dev/null 2>&1 || die "folder '$fid' already exists (see: psync folders)"
  # Syncthing cannot sync a folder inside another one, in either direction.
  for other in $(folder_ids); do
    opath=$(folder_path "$other")
    opath=${opath%/}
    if [[ $fpath == "$opath" || $fpath == "$opath"/* ]]; then
      die "$fpath is already synced as part of folder $other ($opath)"
    fi
    if [[ $opath == "$fpath"/* ]]; then
      die "folder $other ($opath) lives inside $fpath: a folder cannot contain another"
    fi
  done

  mkdir -p "$fpath"
  devices=$(api GET config/devices | jq -c '[.[] | {deviceID: .deviceID}]')
  api PUT "config/folders/$fid" "$(folder_json "$fid" "$fpath" "$devices" "$(jq -n \
    --arg dir "$VERSIONS_DIR/$fid" --arg days "$((VERSIONS_MAX_AGE / 86400))" \
    '{type: "trashcan", params: {cleanoutDays: $days}, fsPath: $dir, cleanupIntervalS: 3600}')")" >/dev/null
  echo "added folder $fid: ${fpath/#"$HOME"/\~}, shared with $(($(jq length <<<"$devices") - 1)) other host(s)"
  echo "it syncs with each host once that host runs the same command; follow with: psync folders"
}

folder_remove() {
  local fid=${1-} answer
  [[ -n $fid ]] || die "usage: psync folder remove ID [--yes]"
  shift
  api GET "config/folders/$fid" >/dev/null 2>&1 || die "no folder '$fid' (see: psync folders)"
  [[ $fid != "$FOLDER_ID" ]] || die "$fid is the base folder: to stop syncing it use psync pause"
  if [[ ${1-} != --yes ]]; then
    [[ -t 0 ]] || die "not a terminal: pass --yes to confirm removing folder $fid"
    read -r -p "Stop syncing folder $fid on this host? The files stay where they are. [y/N] " answer
    [[ $answer == [yY]* ]] || { echo "aborted"; return 1; }
  fi
  api DELETE "config/folders/$fid" >/dev/null
  echo "removed folder $fid from this host; the other hosts keep it until they remove it too"
}

cmd_folder() {
  local action=${1-}
  [[ -z $action ]] || shift
  case $action in
    add) folder_add "$@" ;;
    remove) folder_remove "$@" ;;
    *) die "usage: psync folder add ID PATH | add --preset claude|codex | remove ID [--yes]" ;;
  esac
}

set_paused() { # true|false
  local id
  for id in $(folder_ids); do api PATCH "config/folders/$id" "{\"paused\": $1}" >/dev/null; done
}

cmd_setup() {
  local peer_id="" peer_name="" peer_address=dynamic listen="tcp://:22000" intro=true
  while (($#)); do
    case $1 in
      --peer-id) peer_id=$2; shift 2 ;;
      --peer-name) peer_name=$2; shift 2 ;;
      --peer-address) peer_address=$2; shift 2 ;;
      --listen) listen=$2; shift 2 ;;
      --no-introducer) intro=false; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  mkdir -p "$FOLDER_PATH"
  [[ -r $FOLDER_PATH/$IGNORE_INCLUDE ]] ||
    die "missing $FOLDER_PATH/$IGNORE_INCLUDE — copy it from another host before the first sync"
  local stignore="#include $IGNORE_INCLUDE"
  if [[ "$(cat "$FOLDER_PATH/.stignore" 2>/dev/null)" != "$stignore" ]]; then
    [[ ! -e $FOLDER_PATH/.stignore ]] || cp "$FOLDER_PATH/.stignore" "$FOLDER_PATH/.stignore.bak"
    echo "$stignore" >"$FOLDER_PATH/.stignore"
  fi

  [[ -r $ST_HOME/config.xml ]] || syncthing generate --home="$ST_HOME" --no-port-probing >/dev/null
  systemctl --user enable --now syncthing.service
  local up=false
  for _ in $(seq 30); do
    if api GET system/ping >/dev/null 2>&1; then up=true; break; fi
    sleep 1
  done
  $up || die "Syncthing API did not come up (journalctl --user -u syncthing)"

  api PATCH config/options "$(jq -n --arg listen "$listen" '{
    listenAddresses: [$listen],
    globalAnnounceEnabled: false, localAnnounceEnabled: false,
    relaysEnabled: false, natEnabled: false,
    urAccepted: -1, crashReportingEnabled: false, autoUpgradeIntervalH: 0
  }')" >/dev/null
  api DELETE config/folders/default >/dev/null 2>&1 || true

  local devices existing folder
  devices=$(jq -n --arg me "$(my_id)" '[{deviceID: $me}]')
  if [[ -n $peer_id ]]; then
    put_device "$peer_id" "${peer_name:-$peer_id}" "$peer_address" "$intro"
    devices=$(jq --arg id "$peer_id" '. + [{deviceID: $id}]' <<<"$devices")
  fi
  if existing=$(api GET "config/folders/$FOLDER_ID" 2>/dev/null); then
    devices=$(jq --argjson new "$devices" '.devices + $new | unique_by(.deviceID)' <<<"$existing")
  fi

  folder=$(folder_json "$FOLDER_ID" "$FOLDER_PATH" "$devices" \
    "$(jq -n --arg maxAge "$VERSIONS_MAX_AGE" '{type: "staggered", params: {maxAge: $maxAge}, cleanupIntervalS: 3600}')")
  api PUT "config/folders/$FOLDER_ID" "$folder" >/dev/null

  # Headless hosts have no notify-send: the timer still runs the settle scan and tidy-up.
  systemctl --user enable --now psync-check.timer
  echo "This device: $(my_id)"
}

case ${1:-status} in
  status) cmd_status ;;
  wait) shift; cmd_wait "$@" ;;
  ready) shift; cmd_ready "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  conflicts) conflict_files ;;
  pause) set_paused true && echo "paused — resume with: psync resume" ;;
  resume)
    systemctl --user start syncthing.service
    for _ in $(seq 30); do api GET system/ping >/dev/null 2>&1 && break; sleep 1; done
    set_paused false && echo "resumed — follow with: psync status"
    ;;
  check) cmd_check ;;
  doctor) shift; cmd_doctor "$@" ;;
  hosts) cmd_hosts ;;
  add-host) shift; cmd_add_host "$@" ;;
  remove-host) shift; cmd_remove_host "$@" ;;
  folders) cmd_folders ;;
  folder) shift; cmd_folder "$@" ;;
  tidy) park_index_conflicts ;;
  setup) shift; cmd_setup "$@" ;;
  -h | --help | help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (see psync --help)" ;;
esac
